# Isi CI/CD variable bertipe File `DATADOCK_ROOT_ENV_FILE` (Protected, scope `production`).
# Akun root/superuser instance database bare-metal yang sudah ada. HANYA dipakai deploy.sh untuk membuat atau
# menyelaraskan akun `dbaas_admin` hak minimum (bootstrap). File ini tidak disalin ke server dan tidak pernah
# masuk ke container control plane. Bila variable tidak diisi, bootstrap dilewati (akun admin dianggap sudah ada).
#
# Hanya URL untuk engine di ENGINES (env file control plane) yang wajib; baris engine lain boleh dihapus.
# Host dilihat dari dalam container: host.docker.internal menunjuk ke server itu sendiri.
PG_ROOT_URL=postgres://postgres:<password>@host.docker.internal:5432/postgres
MARIADB_ROOT_URL=mysql://root:<password>@host.docker.internal:3306
MONGO_ROOT_URL=mongodb://root:<password>@host.docker.internal:27017/?authSource=admin
