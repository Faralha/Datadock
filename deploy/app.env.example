# Isi CI/CD variable bertipe File `DATADOCK_ENV_FILE` (Protected, scope `production`).
# Disalin deploy.sh ke /opt/environments/<env>/configs/.env.<container> (chmod 600).
# Yang diatur deploy.sh sendiri (jangan diisi di sini): PUBLIC_URL, TRUST_PROXY, COOKIE_SECURE, TENANT_PREFIX,
# CI_VARIABLES_ENABLED.

# Engine yang dipakai, dipisah koma (default: postgres,mariadb,mongo). Engine yang tidak disebut tidak butuh
# *_HOST/*_ADMIN_PASSWORD/*_ROOT_URL dan tidak ditawarkan di UI. Contoh hanya PostgreSQL: ENGINES=postgres
ENGINES=postgres,mariadb,mongo

# Instance database bare-metal yang sudah ada, dilihat dari dalam container control plane.
# host.docker.internal = server itu sendiri (deploy.sh menambahkan host-gateway).
PG_HOST=host.docker.internal
PG_PORT=5432
MARIADB_HOST=host.docker.internal
MARIADB_PORT=3306
MONGO_HOST=host.docker.internal
MONGO_PORT=27017

# Alamat yang dipakai aplikasi tenant dan ditampilkan di UI / CI variable (default: sama dengan *_HOST/*_PORT).
# Isi dengan hostname atau IP server yang bisa dijangkau aplikasi lewat TCP. JANGAN db.iimlab.id: nama itu milik
# web UI production dan lewat Cloudflare tunnel, yang hanya meneruskan HTTP.
PUBLIC_PG_HOST=
PUBLIC_MARIADB_HOST=
PUBLIC_MONGO_HOST=

# Password akun admin hak minimum (dibuat/diselaraskan bootstrap setiap deploy)
PG_ADMIN_PASSWORD=
MARIADB_ADMIN_PASSWORD=
MONGO_ADMIN_PASSWORD=

# 32 byte base64 (AES-256-GCM). JANGAN diganti setelah ada database: password tersimpan tidak bisa dibaca lagi.
ENCRYPTION_KEY=
SESSION_TTL_HOURS=12

# GitLab OAuth application: redirect URI = <URL environment>/auth/callback
# (https://db.iimlab.id/auth/callback)
GITLAB_URL=https://gitlab.iimlab.id
# Bila GitLab berjalan di server yang sama, namanya di server bisa di-resolve ke 127.0.0.1, yang di dalam container
# berarti container itu sendiri (login gagal "Unable to connect"). Pilih SATU:
# - CONTAINER_DNS=1.1.1.1,1.0.0.1 : container memakai DNS publik, jadi GitLab dihubungi lewat Cloudflare seperti browser
#   (sertifikat valid). Dipakai di server lab.
# - GITLAB_HOST_IP=host-gateway (atau IP internal): langsung ke server. Hanya bila sertifikat GitLab di server
#   dipercaya; sertifikat self-signed ditolak.
CONTAINER_DNS=
GITLAB_HOST_IP=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Token bot: scope `api` pada group lab (NFR-05)
GITLAB_BOT_TOKEN=
ADMIN_USERNAMES=
ADMIN_GROUP=

# Direktori host untuk file backup (sebaiknya di disk terpisah dari data database).
# Default: /opt/environments/<env>/backups. Subdirektori per instance dibuat otomatis.
BACKUP_HOST_DIR=

BACKUP_HOUR_UTC=19
BACKUP_RETENTION_DAYS=7
QUOTA_MAX_DATABASES=3
QUOTA_MAX_SIZE_MB=1024
QUOTA_MAX_CONNECTIONS=20
QUERY_TIMEOUT_S=30
PG_HARD_BLOCK_PERCENT=120
