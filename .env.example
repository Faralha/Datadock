# Salin ke .env lalu ganti semua nilai rahasia. .env tidak boleh masuk repo.

# --- Akun root engine: HANYA dipakai `bun run bootstrap` (sekali), bukan oleh control plane saat berjalan
PG_ROOT_PASSWORD=change-me-pg-root
MARIADB_ROOT_PASSWORD=change-me-mariadb-root
MONGO_ROOT_PASSWORD=change-me-mongo-root

# --- Akun admin hak minimum per engine (dibuat oleh bootstrap, dipakai control plane)
PG_ADMIN_PASSWORD=change-me-pg-admin
MARIADB_ADMIN_PASSWORD=change-me-mariadb-admin
MONGO_ADMIN_PASSWORD=change-me-mongo-admin

# --- Control plane
PORT=3000
PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=false
# 32 byte base64 untuk AES-256-GCM (NFR-03). Buat dengan: bun -e "console.log(crypto.getRandomValues(new Uint8Array(32)).toBase64())"
ENCRYPTION_KEY=
SESSION_TTL_HOURS=12

# --- GitLab
GITLAB_URL=https://gitlab.iimlab.id
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Token bot: scope `api` pada group lab (NFR-05); dipakai sinkron anggota berkala
GITLAB_BOT_TOKEN=
# Admin platform (FR-02): daftar username dipisah koma dan/atau path grup GitLab
ADMIN_USERNAMES=
ADMIN_GROUP=

# --- Host yang dipakai aplikasi/runner untuk konek ke engine (ditampilkan di UI dan connection string)
PUBLIC_PG_HOST=localhost
PUBLIC_PG_PORT=5432
PUBLIC_MARIADB_HOST=localhost
PUBLIC_MARIADB_PORT=3306
PUBLIC_MONGO_HOST=localhost
PUBLIC_MONGO_PORT=27017

# --- Backup (dump dengan tool klien di container control plane)
# 02.00 WIB = 19.00 UTC
BACKUP_HOUR_UTC=19
BACKUP_RETENTION_DAYS=7

# --- Quota default per project
QUOTA_MAX_DATABASES=3
QUOTA_MAX_SIZE_MB=1024
QUOTA_MAX_CONNECTIONS=20
QUERY_TIMEOUT_S=30
# PostgreSQL: read-only lewat default_transaction_read_only bisa di-bypass tenant (spike PG-12b),
# jadi di atas persentase ini koneksi tenant diblokir total (CONNECTION LIMIT 0)
PG_HARD_BLOCK_PERCENT=120
